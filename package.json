{
  "name": "greyzone-table",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "test:ui": "playwright test",
    "doctor": "tsx scripts/doctor.ts",
    "test:live": "tsx scripts/live-campaign.ts",
    "test:live:multiplayer": "tsx scripts/live-multiplayer.ts",
    "report:live": "tsx scripts/report-live.ts",
    "format": "prettier --write server shared src tests scripts runtime content docs README.md"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^6.3.6"
  }
}
