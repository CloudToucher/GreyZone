# Copy to .env if you need to override defaults. Credentials stay in dsh.
PORT=4317
HOST=127.0.0.1
DATA_DIR=.data
# Optional absolute path to dsh's bin.js or native executable.
# DSH_BIN=C:/Users/yourname/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/lib/bin.js
DSH_TIMEOUT_MS=240000
# For LAN hosting set HOST=0.0.0.0 and set the browser's exact origin.
# ALLOWED_ORIGIN=http://192.168.1.10:4317
