HOST=127.0.0.1
PORT=4317
DATA_DIR=.data/v3

# AI Provider: dsh or claude
AI_PROVIDER=dsh

# DSH Configuration (when AI_PROVIDER=dsh)
# DSH_BIN=C:/Users/you/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/lib/bin.js
DSH_TIMEOUT_MS=600000

# Claude Configuration (when AI_PROVIDER=claude)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4.8-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Monitor Token (for /monitor page)
# MONITOR_TOKEN=your-secret-token-here

# For LAN access, set HOST=0.0.0.0 and ALLOWED_ORIGIN to your exact browser origin.
# ALLOWED_ORIGIN=http://192.168.1.10:4317
